    {
      "type": "table",
      "title": "Per symbol (from Postgres)",
      "id": 21,
      "description": "Straight from the table: what a user of the data sees. Quiet symbols can legitimately be seconds old.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trades-db"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trades-db"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT symbol,\n       count(*) FILTER (WHERE ingested_at > now() - interval '5 minutes') AS \"stored 5m\",\n       round(extract(epoch FROM now() - max(trade_time))::numeric, 1)   AS \"last trade age s\",\n       round((percentile_cont(0.99) WITHIN GROUP (ORDER BY extract(epoch FROM ingested_at - trade_time))\n              FILTER (WHERE ingested_at > now() - interval '5 minutes') * 1000)::numeric) AS \"p99 ms 5m\"\nFROM trades\nWHERE trade_time > now() - interval '1 hour'\nGROUP BY symbol ORDER BY symbol"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Gaps in trade ids, last 24h (missing trades)",
      "id": 22,
      "description": "Binance trade ids are sequential per symbol, so a hole is a trade we never stored. Trades newer than 30s are excluded: across 12 partitions ids briefly land out of order. Empty = complete.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trades-db"
      },
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trades-db"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH ordered AS (\n  SELECT symbol, trade_id, trade_time,\n         lag(trade_id)   OVER w AS prev_id,\n         lag(trade_time) OVER w AS prev_time\n  FROM trades WHERE trade_time > now() - interval '24 hours'\n                 -- skip the live edge: ids land out of order across partitions for a moment\n                 AND trade_time < now() - interval '30 seconds'\n  WINDOW w AS (PARTITION BY symbol ORDER BY trade_id))\nSELECT date_trunc('second', min(prev_time)) AS \"gap from\",\n       date_trunc('second', max(trade_time)) AS \"gap to\",\n       count(DISTINCT symbol)                AS symbols,\n       sum(trade_id - prev_id - 1)           AS \"missing trades\"\nFROM ordered WHERE trade_id - prev_id > 1\nGROUP BY date_trunc('minute', prev_time) ORDER BY 1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
