    {
      "type": "table",
      "title": "Latest trades",
      "id": 17,
      "description": "The trades table (assignment step 2), newest first, values exactly as stored. notional = price x quantity, computed by Postgres (generated column).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "trades-db"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "trades-db"
          },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- Cast to text so Grafana shows the stored values exactly instead of rounding them.\nSELECT trade_id::text AS trade_id, symbol,\n       price::text AS price, quantity::text AS quantity, notional::text AS notional,\n       to_char(trade_time AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI:SS.MS') || ' UTC' AS trade_time\nFROM trades\nORDER BY trades.trade_time DESC  -- the column, not the text alias, so the index is used\nLIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trade_id"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "symbol"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "price"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "quantity"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
