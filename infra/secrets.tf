# Passwords that aren't IAM-capable: Grafana's admin login, the read-only DB
# user Grafana and postgres_exporter use, and the UI gateway's login. Neither ever touches Git or state:
#   - generated by an ephemeral resource (never written to state or plan)
#   - written with secret_string_wo (write-only: sent to AWS, not stored)
# External Secrets copies them into Kubernetes; db-init sets the DB password.
# To rotate: bump the *_version local and apply.

locals {
  grafana_admin_version = 1
  grafana_db_version    = 1
  ui_admin_version      = 1
}

ephemeral "random_password" "grafana_admin" {
  length  = 32
  special = false
}

ephemeral "random_password" "grafana_db" {
  length  = 32
  special = false
}

ephemeral "random_password" "ui_admin" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "grafana_admin" {
  name                    = "${local.name}/grafana-admin"
  recovery_window_in_days = 0 # destroy deletes immediately, so a rebuild can reuse the name
}

resource "aws_secretsmanager_secret_version" "grafana_admin" {
  secret_id = aws_secretsmanager_secret.grafana_admin.id
  secret_string_wo = jsonencode({
    "admin-user"     = "admin"
    "admin-password" = ephemeral.random_password.grafana_admin.result
  })
  secret_string_wo_version = local.grafana_admin_version
}

resource "aws_secretsmanager_secret" "grafana_db" {
  name                    = "${local.name}/grafana-db"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "grafana_db" {
  secret_id = aws_secretsmanager_secret.grafana_db.id
  secret_string_wo = jsonencode({
    username = "grafana"
    password = ephemeral.random_password.grafana_db.result
  })
  secret_string_wo_version = local.grafana_db_version
}

# Login for Kafka UI, Prometheus and Alertmanager behind the UI gateway.
resource "aws_secretsmanager_secret" "ui_admin" {
  name                    = "${local.name}/ui-admin"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "ui_admin" {
  secret_id = aws_secretsmanager_secret.ui_admin.id
  secret_string_wo = jsonencode({
    username = "admin"
    password = ephemeral.random_password.ui_admin.result
  })
  secret_string_wo_version = local.ui_admin_version
}

# External Secrets controller: read these secrets, nothing else.
module "external_secrets_role" {
  source                   = "./modules/irsa-role"
  name                     = "${local.name}-irsa-external-secrets"
  permissions_boundary_arn = var.permissions_boundary_arn
  oidc_provider_arn        = module.eks.oidc_provider_arn
  oidc_host                = module.eks.oidc_host
  namespace                = "external-secrets"
  service_account          = "external-secrets"
  inline_policy_name       = "read-ui-secrets"
  inline_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Action = ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"]
      Resource = [
        aws_secretsmanager_secret.grafana_admin.arn,
        aws_secretsmanager_secret.grafana_db.arn,
        aws_secretsmanager_secret.ui_admin.arn,
      ]
    }]
  })
}
